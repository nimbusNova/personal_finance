# Environment Configuration - Local SQLite Edition
# Copy this file to .env and fill in your Kimi API key

# Kimi (Moonshot AI) - Required for PDF extraction
KIMI_API_KEY=your-kimi-api-key-here

# Kimi API endpoint (default: https://api.moonshot.cn/v1)
# Use https://api.moonshot.ai/v1 if your account is on the .ai endpoint
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Kimi model (default: kimi-k2.5)
# Other options: kimi-k2-turbo-preview, moonshot-v1-32k, etc.
KIMI_MODEL=kimi-k2.5

# Auth (change in production)
SECRET_KEY=change-this-secret-key-in-production

# API
DEBUG=true

# Paths are auto-configured, but you can override:
# DATA_DIR=/custom/path/to/data
# DB_PATH=/custom/path/to/personal_finance.db