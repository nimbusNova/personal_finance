# ── AI Provider ──────────────────────────────────────────────────────────────
# Set AI_PROVIDER to one of: kimi | openai | anthropic | google | groq | ollama
# If unset, the app auto-detects based on which *_API_KEY is present.
AI_PROVIDER=kimi

# Optionally override the model used for each task
# AI_MODEL=moonshot-v1-128k
# AI_CLASSIFICATION_MODEL=moonshot-v1-32k
# AI_EXTRACTION_MODEL=moonshot-v1-128k

# Custom base URL (useful for proxies or self-hosted OpenAI-compatible endpoints)
# AI_BASE_URL=https://api.moonshot.cn/v1

# ── API Keys (only the one matching AI_PROVIDER is required) ─────────────────
KIMI_API_KEY=your-kimi-api-key-here          # https://platform.moonshot.cn/
# OPENAI_API_KEY=your-openai-api-key-here    # https://platform.openai.com/
# ANTHROPIC_API_KEY=your-anthropic-key-here  # https://console.anthropic.com/
# GOOGLE_API_KEY=your-google-key-here        # https://aistudio.google.com/
# GROQ_API_KEY=your-groq-key-here            # https://console.groq.com/

# ── Logging ───────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_LOG_LEVEL=info   # debug | info | warn | error
